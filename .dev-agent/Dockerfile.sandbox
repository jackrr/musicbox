# Sandbox toolchain image for musicbox dev-agent sessions.
#
# Contains the full Flutter + Rust + Android toolchain needed to build,
# test, and produce an APK from a freshly-cloned worktree.
#
# This image is built once by Component 1 (dev-agent-server) on first
# session creation (per `sandbox.build` in .dev-agent/config.yaml) and
# reused for subsequent sessions. The runner image (.dev-agent/runner/
# Dockerfile) extends this with the GitHub Actions runner agent.
#
# Layout note:
#   The harness runs this image with a read-only root and a ~1 GB tmpfs
#   mounted over /home/agent. At mount time the kernel copies the
#   existing contents of /home/agent into that tmpfs (tmpcopyup), so
#   /home/agent must stay small. All toolchains therefore live under
#   /opt/<tool> (read-only at runtime), while only per-user caches
#   (~/.cargo/registry, ~/.npm, ~/.gradle, ~/.pub-cache, …) land on the
#   writable tmpfs at $HOME.

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ---- base packages -----------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        bash ca-certificates curl wget git gnupg unzip zip xz-utils \
        build-essential pkg-config libssl-dev \
        openjdk-17-jdk-headless \
        python3 \
        nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# ---- gh CLI ------------------------------------------------------------------
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# ---- toolchain locations (all under /opt, read-only at runtime) --------------
ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_VERSION=28.2.13676358 \
    FLUTTER_HOME=/opt/flutter \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    NPM_GLOBAL=/opt/npm-global
ENV ANDROID_NDK_HOME=${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION} \
    PATH=${CARGO_HOME}/bin:${FLUTTER_HOME}/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${NPM_GLOBAL}/bin:${PATH}

# All toolchain installs run as root into /opt so they survive a read-only
# rootfs at runtime. We chmod a+rX at the end so uid 1000 can read/execute.
WORKDIR /opt

# ---- Android cmdline-tools, platform, build-tools, NDK -----------------------
ARG ANDROID_CMDLINE_VERSION=11076708
ARG CMAKE_VERSION=3.22.1
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools \
 && curl -fsSL -o /tmp/cmdline-tools.zip \
      https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_CMDLINE_VERSION}_latest.zip \
 && unzip -q /tmp/cmdline-tools.zip -d ${ANDROID_HOME}/cmdline-tools \
 && mv ${ANDROID_HOME}/cmdline-tools/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest \
 && rm /tmp/cmdline-tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager \
      "platform-tools" \
      "platforms;android-35" \
      "build-tools;35.0.0" \
      "ndk;${ANDROID_NDK_VERSION}" \
      "cmake;${CMAKE_VERSION}"

# ---- Rust + Android targets + cargo-ndk --------------------------------------
# Installed with CARGO_HOME=/opt/cargo, RUSTUP_HOME=/opt/rustup so binaries
# and toolchains live under /opt. At runtime we override CARGO_HOME to
# $HOME/.cargo (see end of file) so the registry/cache lands on the tmpfs.
RUN curl -fsSL https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal --no-modify-path \
 && rustup target add aarch64-linux-android armv7-linux-androideabi \
 && cargo install cargo-ndk \
 && rm -rf ${CARGO_HOME}/registry ${CARGO_HOME}/git

# ---- Flutter -----------------------------------------------------------------
# Flutter is a git checkout; it wants to call `git` against its own repo.
# We mark it as a safe directory globally so any user can invoke flutter.
ARG FLUTTER_VERSION=3.41.6
RUN curl -fsSL -o /tmp/flutter.tar.xz \
      https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz \
 && tar -xJf /tmp/flutter.tar.xz -C /opt \
 && rm /tmp/flutter.tar.xz \
 && git config --system --add safe.directory ${FLUTTER_HOME} \
 && flutter config --no-analytics --no-cli-animations \
 && flutter precache --android --no-ios --no-linux --no-windows --no-macos --no-web \
 && yes | flutter doctor --android-licenses >/dev/null || true \
 && flutter --version

# ---- qrcode for the build-apk workflow's QR step -----------------------------
# Global npm prefix lives under /opt so the package files are read-only at
# runtime. Per-user npm cache (~/.npm) stays under $HOME automatically.
RUN npm config set prefix ${NPM_GLOBAL} \
 && npm install -g qrcode \
 && rm -rf /root/.npm

# ---- make everything under /opt world-readable/executable --------------------
RUN chmod -R a+rX /opt

# ---- profile.d snippet: restore tool PATH for login shells ------------------
# When a login shell starts, /etc/profile resets PATH to the Debian default,
# wiping out the Docker ENV PATH. This snippet runs after /etc/profile and
# puts the toolchain directories back on PATH for every user/shell type.
RUN printf '%s\n' \
      '# musicbox toolchain — added by Dockerfile.sandbox' \
      'export CARGO_HOME="${CARGO_HOME:-/opt/cargo}"' \
      'export RUSTUP_HOME="${RUSTUP_HOME:-/opt/rustup}"' \
      'export FLUTTER_HOME=/home/agent/flutter' \
      'export ANDROID_HOME=/opt/android-sdk' \
      'export ANDROID_SDK_ROOT=/opt/android-sdk' \
      'export NPM_GLOBAL=/opt/npm-global' \
      'export ANDROID_NDK_HOME="${ANDROID_HOME}/ndk/${ANDROID_NDK_VERSION}"' \
      'case ":${PATH}:" in' \
      '  *":/opt/cargo/bin:"*) ;;' \
      '  *) export PATH="/opt/cargo/bin:/home/agent/flutter/bin:${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/platform-tools:${NPM_GLOBAL}/bin:${PATH}" ;;' \
      'esac' \
    > /etc/profile.d/toolchain.sh \
 && chmod 644 /etc/profile.d/toolchain.sh

# ---- sandbox entrypoint ----------------------------------------------------
COPY --chmod=755 entrypoint.sandbox.sh /usr/local/bin/entrypoint.sh

# ---- non-root user -----------------------------------------------------------
ARG USER=agent
ARG UID=1000
RUN useradd -m -u ${UID} -s /bin/bash ${USER}

# At runtime, redirect per-user caches into $HOME so they land on the
# writable tmpfs. The cargo/rustup *binaries* still come from /opt/cargo/bin
# (on PATH); only the registry/git caches and any user-installed crates go
# into $HOME/.cargo. RUSTUP_HOME stays under /opt — toolchains are immutable.
ENV HOME=/home/${USER} \
    CARGO_HOME=/home/${USER}/.cargo \
    PUB_CACHE=/home/${USER}/.pub-cache \
    GRADLE_USER_HOME=/home/${USER}/.gradle \
    PATH=/opt/cargo/bin:/home/agent/flutter/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

USER ${USER}
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
